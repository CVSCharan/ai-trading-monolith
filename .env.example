# Application
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# Database (Neon PostgreSQL) - Replace with your connection string
# Format: postgresql://user:pass@host/db?sslmode=require&channel_binding=require
DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/dbname?sslmode=require&channel_binding=require
DATABASE_POOL_SIZE=10

# Better Auth
BETTER_AUTH_SECRET=your-32-char-secret-here
BETTER_AUTH_URL=http://localhost:3000

# Encryption (Envelope encryption - KEK from OS keychain/env)
# Generate with: openssl rand -hex 32
ENCRYPTION_MASTER_KEY=your-32-byte-hex-key-for-dev-only

# Groww API (get from Groww developer portal)
GROWW_API_KEY=your-groww-api-key
GROWW_API_SECRET=your-groww-api-secret
GROWW_TOTP_SECRET=your-totp-secret-from-keys.txt
GROWW_REDIRECT_URI=http://localhost:3000/api/auth/groww/callback

# Market Hours
MARKET_OPEN=09:15
MARKET_CLOSE=15:30
TIMEZONE=Asia/Kolkata

# Default Risk Limits (user can override in UI)
DEFAULT_MAX_DAILY_LOSS_PCT=2
DEFAULT_MAX_POSITIONS=3
DEFAULT_PER_TRADE_RISK_PCT=1
DEFAULT_PAPER_CAPITAL=1000000

# Feature Flags
ENABLE_LIVE_TRADING=false
ENABLE_PAPER_TRADING=true
ENABLE_BACKTEST=true

# Cost Configuration (DYNAMIC - loaded from cost_configs table in DB)
# The values below are ONLY fallback defaults if DB lookup fails.
# Real values are stored in cost_configs table with dated effectiveness.
COST_CONFIG_EFFECTIVE_FROM=2024-01-01
COST_BROKERAGE_PER_ORDER=20
COST_STT_PCT=0.001
COST_EXCHANGE_PCT=0.0005
COST_GST_PCT=0.18
COST_SEBI_PER_CRORE=10
COST_STAMP_PCT=0.00003
COST_SLIPPAGE_TICKS=1