{
  "$schema": "https://turbo.build/schema.json",
  "pipeline": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "outputs": ["coverage/**"],
      "dependsOn": []
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "db:generate": {},
    "db:migrate": {},
    "db:push": {},
    "db:studio": {},
    "db:seed": {}
  },
  "globalEnv": ["NODE_ENV", "DATABASE_URL", "BETTER_AUTH_SECRET"],
  "globalDependencies": [".env*"]
}