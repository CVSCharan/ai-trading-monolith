{
  "name": "@groww-trading/api",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "tsc",
    "start": "bun run dist/index.js",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun run src/db/seed.ts"
  },
  "dependencies": {
    "elysia": "^1.1.0",
    "@elysiajs/swagger": "^1.1.0",
    "@elysiajs/cors": "^1.1.0",
    "@elysiajs/jwt": "^1.1.0",
    "better-auth": "^1.0.0",
    "drizzle-orm": "^0.33.0",
    "postgres": "^3.4.0",
    "zod": "^3.23.0",
    "crypto-js": "^4.2.0",
    "otplib": "^12.0.1",
    "ws": "^8.18.0",
    "date-fns": "^3.6.0",
    "pino": "^9.0.0",
    "pino-pretty": "^11.0.0",
    "@groww-trading/shared": "workspace:*",
    "@groww-trading/strategy-core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "drizzle-kit": "^0.24.0",
    "@types/bun": "^1.1.0",
    "@types/crypto-js": "^4.2.0",
    "@types/ws": "^8.5.0"
  }
}